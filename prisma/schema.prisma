generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ParentProfile {
  id                  String    @id @default(uuid())
  cognitoSub          String    @unique
  firstName           String
  lastName            String
  visibleName         String?
  tuitionType         String?
  nationality         String?
  nriOrIndian         String?
  address             String?
  city                String?
  country             String?
  pincode             String?
  currency            String?
  timezone            String?
  phone               String
  whatsappNumber      String?
  email               String    @unique
  relationToStudent   String?
  childStatus         String?
  onlineTuition       String?
  modeOfCommunication String?
  childInterest       String?
  favoriteSubject     String?
  weakSubject         String?
  preferredLanguage   String?
  howDidYouHear       String?
  suggestions         String?
  onboardingComplete  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  students            Student[]
  demoCoupon          DemoCoupon?
}

model Admin {
  id        String   @id @default(uuid())
  cognitoId String   @unique
  email     String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
}

model Student {
  id                   String        @id @default(uuid())
  parentId             String
  firstName            String
  lastName             String
  visibleName          String?
  gender               String?
  age                  Int?
  dateOfBirth          DateTime?
  standard             String?
  board                String?
  currentSchoolName    String?
  learningDifficulties String?
  photoUrl             String?
  createdAt            DateTime      @default(now())
  parent               ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  demoBookings         DemoBooking[]

  @@index([parentId])
}

model Teacher {
  id               String                @id @default(uuid())
  cognitoId        String                @unique
  email            String                @unique
  firstName        String
  lastName         String
  visibleName      String?
  dobDay           Int?
  dobMonth         String?
  dobYear          Int?
  gender           String?
  nationality      String?
  address          String?
  city             String?
  country          String?
  pincode          String?
  phone            String?
  whatsapp         String?
  aboutMe          String?
  criminalCase     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  currentStep      Int                   @default(1)
  onboardingStatus String                @default("IN_PROGRESS")
  approvalStatus   TeacherApprovalStatus @default(PENDING)
  panCardNumber    String?

  files            TeacherFile[]
  courses          Course[]
  professionalInfo TeacherProfessional?
  demoBookings     DemoBooking[]
}

model TeacherProfessional {
  id                   String  @id @default(uuid())
  teacherId            String  @unique
  referredBy           String?
  qualifications       String?
  overallExperience    String?
  comfortableLanguage  String?
  schoolsTaught        String?
  workingInSchool      Boolean @default(false)
  schoolName           String?
  workingInAcademy     Boolean @default(false)
  academyName          String?
  homeTuitionArea      String?
  studentsTaught       String?
  canTakeHomeTuition   String?
  hoursPerDay          String?
  haveOwnNotes         String?
  canMakePresentations String?
  provideHomework      String?
  conductPTM           String?
  hasLaptop            Boolean @default(false)
  hasPenTab            Boolean @default(false)
  proficientInEnglish  Boolean @default(false)
  notWithOtherAcademy  Boolean @default(false)
  additionalInfo       String?
  facebook             String?
  linkedin             String?
  instagram            String?
  youtube              String?
  teacher              Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherFile {
  id               String          @id @default(uuid())
  teacherId        String
  type             TeacherFileType
  s3Key            String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  teacher          Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([teacherId, type])
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeacherFileType {
  PROFILE_PHOTO
  INTRO_VIDEO
  CERTIFICATION
  AWARD
  DOB_PROOF
  ADDRESS_PROOF
  QUALIFICATION_PROOF
}

model Course {
  id String @id @default(uuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  category String?
  timeSlot String?

  subject    String?
  grade      String?
  board      String?
  experience String?

  duration  String?
  type      String?
  language  String?
  frequency String?

  courseTitle String?
  rating      Float?
  objective   String?
  description String?

  modules    String?
  courseTags String?
  price      Decimal? @db.Decimal(10, 2)

  thumbnailKey  String?
  introVideoKey String?

  status CourseStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  demoBookings DemoBooking[]

  @@index([teacherId])
  @@index([status])
  @@index([teacherId, status])
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

/// Every ParentProfile gets exactly one DemoCoupon row, lazily
/// created the first time their balance is checked (see
/// getOrCreateDemoCoupon() in demoCoupon.service.ts). This is
/// account-level, not per-child: 06-OPEN-DECISIONS.md #26 — 2 free
/// demos total, shared across every Student under one parent, then
/// a flat ₹100 each after that.
model DemoCoupon {
  id          String   @id @default(uuid())
  parentId    String   @unique
  parent      ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  totalIssued Int      @default(2)
  usedCount   Int      @default(0)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  bookings    DemoBooking[]
}

/// One row per booked demo session. `subject` defaults to "" (never
/// null) specifically so the (teacherId, subject, studentId) unique
/// constraint below reliably enforces the "at most 1 demo per
/// teacher+subject+child" cap from 06-OPEN-DECISIONS.md #26 —
/// Postgres treats multiple NULLs as distinct in a unique index,
/// which would silently defeat this cap for any course with no
/// subject set.
model DemoBooking {
  id String @id @default(uuid())

  demoCouponId String
  demoCoupon   DemoCoupon @relation(fields: [demoCouponId], references: [id], onDelete: Cascade)

  // Denormalized alongside demoCouponId purely so
  // getDemoBookingsForParent() can filter directly on parentId
  // without an extra join — not declared as its own Prisma relation.
  parentId String

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  subject String @default("")

  isPaid Boolean  @default(false)
  amount Decimal? @db.Decimal(10, 2)
  status DemoBookingStatus @default(CONFIRMED)

  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subject, studentId])
  @@index([parentId])
}

enum DemoBookingStatus {
  CONFIRMED
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
}
