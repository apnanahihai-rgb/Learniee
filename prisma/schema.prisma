generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ParentProfile {
  id                  String    @id @default(uuid())
  cognitoSub          String    @unique
  firstName           String
  lastName            String
  visibleName         String?
  tuitionType         String?
  nationality         String?
  nriOrIndian         String?
  address             String?
  city                String?
  country             String?
  pincode             String?
  currency            String?
  timezone            String?
  phone               String
  whatsappNumber      String?
  email               String    @unique
  relationToStudent   String?
  childStatus         String?
  onlineTuition       String?
  modeOfCommunication String?
  childInterest       String?
  favoriteSubject     String?
  weakSubject         String?
  preferredLanguage   String?
  howDidYouHear       String?
  suggestions         String?
  onboardingComplete  Boolean   @default(false)
  createdAt           DateTime  @default(now())
  students            Student[]
}

model Admin {
  id        String   @id @default(uuid())
  cognitoId String   @unique
  email     String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
}

model Student {
  id                   String        @id @default(uuid())
  parentId             String
  firstName            String
  lastName             String
  visibleName          String?
  gender               String?
  age                  Int?
  dateOfBirth          DateTime?
  standard             String?
  board                String?
  currentSchoolName    String?
  learningDifficulties String?
  photoUrl             String?
  createdAt            DateTime      @default(now())
  parent               ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  @@index([parentId])
}

model Teacher {
  id               String                @id @default(uuid())
  cognitoId        String                @unique
  email            String                @unique
  firstName        String
  lastName         String
  visibleName      String?
  dobDay           Int?
  dobMonth         String?
  dobYear          Int?
  gender           String?
  nationality      String?
  address          String?
  city             String?
  country          String?
  pincode          String?
  phone            String?
  whatsapp         String?
  aboutMe          String?
  criminalCase     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  currentStep      Int                   @default(1)
  onboardingStatus String                @default("IN_PROGRESS")
  approvalStatus   TeacherApprovalStatus @default(PENDING)
  panCardNumber    String?

  files            TeacherFile[]
  courses          Course[]
  professionalInfo TeacherProfessional?
}

model TeacherProfessional {
  id                   String  @id @default(uuid())
  teacherId            String  @unique
  referredBy           String?
  qualifications       String?
  overallExperience    String?
  comfortableLanguage  String?
  schoolsTaught        String?
  workingInSchool      Boolean @default(false)
  schoolName           String?
  workingInAcademy     Boolean @default(false)
  academyName          String?
  homeTuitionArea      String?
  studentsTaught       String?
  canTakeHomeTuition   String?
  hoursPerDay          String?
  haveOwnNotes         String?
  canMakePresentations String?
  provideHomework      String?
  conductPTM           String?
  hasLaptop            Boolean @default(false)
  hasPenTab            Boolean @default(false)
  proficientInEnglish  Boolean @default(false)
  notWithOtherAcademy  Boolean @default(false)
  additionalInfo       String?
  facebook             String?
  linkedin             String?
  instagram            String?
  youtube              String?
  teacher              Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherFile {
  id               String          @id @default(uuid())
  teacherId        String
  type             TeacherFileType
  s3Key            String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  teacher          Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([teacherId, type])
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeacherFileType {
  PROFILE_PHOTO
  INTRO_VIDEO
  CERTIFICATION
  AWARD
  DOB_PROOF
  ADDRESS_PROOF
  QUALIFICATION_PROOF
}

model Course {
  id String @id @default(uuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  category String?
  timeSlot String?

  subject    String?
  grade      String?
  board      String?
  experience String?

  duration  String?
  type      String?
  language  String?
  frequency String?

  courseTitle String?
  rating      Float?
  objective   String?
  description String?

  modules    String?
  courseTags String?
  price      Decimal? @db.Decimal(10, 2)

  thumbnailKey  String?
  introVideoKey String?

  status CourseStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([teacherId])
  @@index([status])
  @@index([teacherId, status])
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}
