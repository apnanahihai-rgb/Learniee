/// In-app notifications (added Sep 8, 2026). Loosely-typed recipient
/// pointer — `recipientId` points at `ParentProfile.id`,
/// `Teacher.id`, or `Admin.id` depending on `recipientRole`, never
/// FK-constrained to any one of them. Same established pattern as
/// `ChatMessage.senderId` elsewhere in this schema (see its
/// doc-comment) — there's still no generic `User` table
/// (06-OPEN-DECISIONS.md #33), so this is how a notification can
/// point at any of the three roles without three separate tables.
/// `ACCOUNTS` is included in `NotificationRecipientRole` for
/// forward-compatibility but nothing writes it yet — Accounts-role
/// notifications (payout verification queue, etc.) are a follow-up,
/// not built in this pass.
enum NotificationRecipientRole {
  PARENT
  TEACHER
  ADMIN
  ACCOUNTS
}

enum NotificationType {
  ENROLLMENT_CREATED
  ENROLLMENT_TEACHER_APPROVED
  ENROLLMENT_REVISION_PROPOSED
  ENROLLMENT_REVISION_CONFIRMED
  ENROLLMENT_REVISION_DECLINED
  ENROLLMENT_REJECTED
  ENROLLMENT_ACTIVATED
  DEMO_BOOKED
  CLASS_SESSION_REMINDER
  CLASS_SESSION_COMPLETED
  CYCLE_PAYOUT_READY
  RESCHEDULE_PROPOSED
  RESCHEDULE_APPROVED
  RESCHEDULE_REJECTED
  LEAVE_REQUEST_SUBMITTED
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  HOMEWORK_ASSIGNED
  HOMEWORK_SUBMITTED
  HOMEWORK_GRADED
  COURSE_APPROVED
  COURSE_REJECTED
  COURSE_PUBLISHED_MATCH
  CHAT_MESSAGE
  WALLET_CREDITED
  TEACHER_APPROVED
  TEACHER_REJECTED
  /// Teacher Payouts (Sep 9, 2026) — see LedgerPayoutStatus's doc-comment.
  PAYOUT_ON_HOLD
  PAYOUT_REJECTED
  PAYOUT_PAID
  GENERIC
}

model Notification {
  id            String                    @id @default(uuid())
  recipientId   String
  recipientRole NotificationRecipientRole
  type          NotificationType
  title         String
  message       String
  link          String?
  isRead        Boolean                   @default(false)
  readAt        DateTime?
  createdAt     DateTime                  @default(now())

  @@index([recipientId, recipientRole, createdAt])
  @@index([recipientId, recipientRole, isRead])
}

/// Admin-facing activity/audit log (added Sep 9, 2026). Deliberately
/// NOT a log of every request — only major, human-meaningful events
/// (login/logout, a class session being completed, a payment
/// clearing, an approval decision, a manual money-adjacent action).
/// See ActivityAction below for the exact covered list.
///
/// `actorId`/`actorRole` is the same loosely-typed pointer pattern
/// already used by `Notification.recipientId` / `ChatMessage.senderId`
/// — no FK, since the actor can be a Parent, Teacher, Admin, or
/// Accounts/HR staff login, and there's still no generic `User`
/// table (06-OPEN-DECISIONS.md #33). `actorName`/`actorEmail` are a
/// denormalized snapshot taken at write time so the log stays
/// readable even if the underlying account is later renamed or
/// deleted (`/admin/users` supports hard-deleting a Parent/Teacher).
/// `metadata` carries structured detail (ids, amounts) for anything
/// not worth putting in the human-readable `description` string.
model ActivityLog {
  id          String            @id @default(uuid())
  action      ActivityAction
  actorRole   ActivityActorRole
  actorId     String?
  actorName   String?
  actorEmail  String?
  description String
  metadata    Json?
  createdAt   DateTime          @default(now())

  @@index([createdAt])
  @@index([action, createdAt])
  @@index([actorRole, createdAt])
}

enum ActivityActorRole {
  PARENT
  TEACHER
  ADMIN
  ACCOUNTS
  HR
  SYSTEM
}

/// One value per major, admin-visible event — deliberately not
/// one-per-API-route. Add new values here (and to the log call site)
/// rather than reusing GENERIC when a new "major thing" needs
/// tracking; GENERIC is a last-resort catch-all only.
enum ActivityAction {
  AUTH_LOGIN
  AUTH_LOGOUT
  CLASS_SESSION_COMPLETED
  PAYMENT_ENROLLMENT
  PAYMENT_DEMO_BOOKING
  PAYMENT_WALLET_TOPUP
  WALLET_CREDITED_MANUAL
  LEAVE_REQUEST_APPROVED
  LEAVE_REQUEST_REJECTED
  ENROLLMENT_TEACHER_APPROVED
  ENROLLMENT_ADMIN_APPROVED
  ENROLLMENT_REJECTED
  TEACHER_APPROVED
  TEACHER_REJECTED
  COURSE_APPROVED
  COURSE_REJECTED
  USER_DELETED
  /// Teacher Payouts (Sep 9, 2026)
  PAYOUT_HELD_OR_REJECTED
  PAYOUT_ADMIN_DECISION
  PAYOUT_MASS_PAID
  GENERIC
}
