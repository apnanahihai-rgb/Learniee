  QUALIFICATION_PROOF
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

enum DemoBookingStatus {
  CONFIRMED
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
}

/// UPDATED Sep 9, 2026 — Teacher Payouts. `APPROVED` is now a
/// LEGACY-ONLY value (same established pattern as
/// `EnrollmentStatus.PENDING_APPROVAL`/`APPROVED` — see
/// 03-DATA-MODEL.md): existing rows are backfilled to
/// `QUEUED_FOR_PAYMENT` by the migration that introduces this
/// change, and no code writes `APPROVED` anymore. The real flow now
/// has two extra stops after Accounts' original Approve/Reject:
///
///   PENDING_VERIFICATION (Accounts' 24h window)
///     -> Accounts "Proceed"  -> QUEUED_FOR_PAYMENT
///     -> Accounts "Hold"     -> ON_HOLD              (routes to Admin)
///     -> Accounts "Reject"   -> REJECTED              (routes to Admin, NOT terminal until Admin confirms)
///     -> (lazy, unchanged)   -> EXPIRED               (same re-decide-able semantics as before)
///
///   ON_HOLD / REJECTED, only while `TuitionLedgerEntry.adminReviewedAt`
///   is still null (i.e. Admin hasn't looked at it yet):
///     -> Admin "Release"        -> QUEUED_FOR_PAYMENT
///     -> Admin "Reopen"         -> PENDING_VERIFICATION (back to Accounts, deadline refreshed)
///     -> Admin "Confirm Reject" -> REJECTED, `adminReviewedAt` set (now genuinely terminal)
///
///   QUEUED_FOR_PAYMENT (Payment tab, grouped by Teacher):
///     -> Accounts mass-pay -> PAID (`TuitionLedgerEntry.payoutRecordId`/`paidAt` set)
///
/// See 06-OPEN-DECISIONS.md #46 for what's still a stub (real
/// RazorpayX Payouts vs. `initiateStubTeacherPayout()`).
enum LedgerPayoutStatus {
  PENDING_VERIFICATION
  ON_HOLD
  QUEUED_FOR_PAYMENT
  PAID
  REJECTED
  EXPIRED
  /// @deprecated legacy-only, see doc-comment above — no code writes this anymore
  APPROVED
}

/// Records which of the three Admin actions was taken on an ON_HOLD/
/// REJECTED ledger entry — lets the Admin queue tell "awaiting review"
/// apart from "already reviewed" without a second enum on
/// `payoutStatus` (same row can be REJECTED either because Accounts
/// just rejected it, awaiting Admin, or because Admin confirmed the
/// rejection — `adminReviewedAt`/`adminDecision` is what disambiguates).
enum PayoutAdminDecision {
  RELEASED
  REOPENED
  CONFIRMED_REJECTED
}

/// A single mass-pay action by Accounts (built Sep 9, 2026, Teacher
/// Payouts) — one row per "Pay selected teachers" click, wrapping
/// one `PayoutRecord` per teacher actually included. `COMPLETED`
/// means every selected teacher had a bank account on file and was
/// paid; `PARTIALLY_COMPLETED` means at least one was skipped for
/// missing bank details (see `PayoutRecordStatus.SKIPPED_NO_BANK_ACCOUNT`)
/// and stayed `QUEUED_FOR_PAYMENT` for the next batch.
enum PayoutBatchStatus {
  COMPLETED
  PARTIALLY_COMPLETED
}

enum PayoutRecordStatus {
  SUCCESS
  SKIPPED_NO_BANK_ACCOUNT
  FAILED
}

enum EnrollmentStatus {
  PENDING_APPROVAL
  APPROVED
  REJECTED
  ACTIVE
  LAPSED
  CANCELLED
  PENDING_TEACHER_APPROVAL
  PENDING_PARENT_RECONFIRMATION
