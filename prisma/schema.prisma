generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model ParentProfile {
  id                  String      @id @default(uuid())
  cognitoSub          String      @unique
  firstName           String
  lastName            String
  visibleName         String?
  tuitionType         String?
  nationality         String?
  nriOrIndian         String?
  address             String?
  city                String?
  country             String?
  pincode             String?
  currency            String?
  timezone            String?
  phone               String
  whatsappNumber      String?
  email               String      @unique
  relationToStudent   String?
  childStatus         String?
  onlineTuition       String?
  modeOfCommunication String?
  childInterest       String?
  favoriteSubject     String?
  weakSubject         String?
  preferredLanguage   String?
  howDidYouHear       String?
  suggestions         String?
  onboardingComplete  Boolean     @default(false)
  createdAt           DateTime    @default(now())
  students            Student[]
  demoCoupon          DemoCoupon?
  chatRooms           ChatRoom[]
  enrollments         Enrollment[]
}

model Admin {
  id        String   @id @default(uuid())
  cognitoId String   @unique
  email     String   @unique
  firstName String
  lastName  String
  createdAt DateTime @default(now())
}

model Student {
  id                   String        @id @default(uuid())
  parentId             String
  firstName            String
  lastName             String
  visibleName          String?
  gender               String?
  age                  Int?
  dateOfBirth          DateTime?
  standard             String?
  board                String?
  currentSchoolName    String?
  learningDifficulties String?
  photoUrl             String?
  createdAt            DateTime      @default(now())
  parent               ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)
  demoBookings         DemoBooking[]
  enrollments          Enrollment[]
  chatRooms            ChatRoom[]

  @@index([parentId])
}

model Teacher {
  id               String                @id @default(uuid())
  cognitoId        String                @unique
  email            String                @unique
  firstName        String
  lastName         String
  visibleName      String?
  dobDay           Int?
  dobMonth         String?
  dobYear          Int?
  gender           String?
  nationality      String?
  address          String?
  city             String?
  country          String?
  pincode          String?
  phone            String?
  whatsapp         String?
  aboutMe          String?
  criminalCase     String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  currentStep      Int                   @default(1)
  onboardingStatus String                @default("IN_PROGRESS")
  approvalStatus   TeacherApprovalStatus @default(PENDING)
  panCardNumber    String?
  TeacherDocuments TeacherDocuments?

  files            TeacherFile[]
  courses          Course[]
  professionalInfo TeacherProfessional?
  demoBookings     DemoBooking[]
  enrollments      Enrollment[]
  chatRooms        ChatRoom[]
}

model TeacherProfessional {
  id                   String  @id @default(uuid())
  teacherId            String  @unique
  referredBy           String?
  qualifications       String?
  overallExperience    String?
  comfortableLanguage  String?
  schoolsTaught        String?
  workingInSchool      Boolean @default(false)
  schoolName           String?
  workingInAcademy     Boolean @default(false)
  academyName          String?
  homeTuitionArea      String?
  studentsTaught       String?
  canTakeHomeTuition   String?
  hoursPerDay          String?
  haveOwnNotes         String?
  canMakePresentations String?
  provideHomework      String?
  conductPTM           String?
  hasLaptop            Boolean @default(false)
  hasPenTab            Boolean @default(false)
  proficientInEnglish  Boolean @default(false)
  notWithOtherAcademy  Boolean @default(false)
  additionalInfo       String?
  facebook             String?
  linkedin             String?
  instagram            String?
  youtube              String?
  teacher              Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

model TeacherFile {
  id               String          @id @default(uuid())
  teacherId        String
  type             TeacherFileType
  s3Key            String
  originalFileName String
  mimeType         String
  fileSize         Int
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  teacher          Teacher         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId])
  @@index([teacherId, type])
}

model TeacherDocuments {
  id                    String  @id
  teacherId             String  @unique
  videoIntroKey         String?
  photoKey              String?
  certificationKey      String?
  awardsKey             String?
  dobProofKey           String?
  addressProofKey       String?
  qualificationProofKey String?
  panCardNumber         String?
  Teacher               Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)
}

enum TeacherApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum TeacherFileType {
  PROFILE_PHOTO
  INTRO_VIDEO
  CERTIFICATION
  AWARD
  DOB_PROOF
  ADDRESS_PROOF
  QUALIFICATION_PROOF
}

model Course {
  id String @id @default(uuid())

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  category String?
  timeSlot String?

  subject    String?
  grade      String?
  board      String?
  experience String?

  duration  String?
  type      String?
  language  String?
  frequency String?

  courseTitle String?
  rating      Float?
  objective   String?
  description String?

  modules    String?
  courseTags String?
  price      Decimal? @db.Decimal(10, 2)

  thumbnailKey  String?
  introVideoKey String?

  status CourseStatus @default(DRAFT)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  ageGroup        String?
  rejectionReason String?

  demoBookings DemoBooking[]
  enrollments  Enrollment[]
  chatRooms    ChatRoom[]

  @@index([teacherId])
  @@index([status])
  @@index([teacherId, status])
}

enum CourseStatus {
  DRAFT
  UNDER_REVIEW
  APPROVED
  REJECTED
  INACTIVE
}

/// Every ParentProfile gets exactly one DemoCoupon row, lazily
/// created the first time their balance is checked (see
/// getOrCreateDemoCoupon() in demoCoupon.service.ts). This is
/// account-level, not per-child: 06-OPEN-DECISIONS.md #26 — 2 free
/// demos total, shared across every Student under one parent, then
/// a flat ₹100 each after that.
model DemoCoupon {
  id       String        @id @default(uuid())
  parentId String        @unique
  parent   ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  totalIssued Int @default(2)
  usedCount   Int @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings DemoBooking[]
}

/// One row per booked demo session. `subject` defaults to "" (never
/// null) specifically so the (teacherId, subject, studentId) unique
/// constraint below reliably enforces the "at most 1 demo per
/// teacher+subject+child" cap from 06-OPEN-DECISIONS.md #26 —
/// Postgres treats multiple NULLs as distinct in a unique index,
/// which would silently defeat this cap for any course with no
/// subject set.
model DemoBooking {
  id String @id @default(uuid())

  demoCouponId String
  demoCoupon   DemoCoupon @relation(fields: [demoCouponId], references: [id], onDelete: Cascade)

  // Denormalized alongside demoCouponId purely so
  // getDemoBookingsForParent() can filter directly on parentId
  // without an extra join — not declared as its own Prisma relation.
  parentId String

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  subject String @default("")

  isPaid Boolean           @default(false)
  amount Decimal?          @db.Decimal(10, 2)
  status DemoBookingStatus @default(CONFIRMED)

  // Razorpay fields — only set for the paid (3rd+) demo path. Free
  // demos never touch Razorpay at all, so these stay null for them.
  // `razorpayOrderId` is unique so verifyDemoPayment() can be called
  // more than once for the same order (e.g. a retried client
  // request) without creating a second DemoBooking row.
  razorpayOrderId   String?   @unique
  razorpayPaymentId String?   @unique
  paidAt            DateTime?

  scheduledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([teacherId, subject, studentId])
  @@index([parentId])
}

enum DemoBookingStatus {
  CONFIRMED
  PENDING_PAYMENT
  COMPLETED
  CANCELLED
}

/// Cycle-based Enrollment (03-DATA-MODEL.md's "Enrollment (extended
/// with cycle/approval logic)" section). This captures ONLY what's
/// knowable/calculable at enrollment time — everything payment-side
/// (Transaction_Date, actual gateway ref, etc.) is deliberately left
/// out until Razorpay is integrated (02-ARCHITECTURE.md). Parent
/// name / child name / teacher name are NOT duplicated here — they
/// live on ParentProfile/Student/Teacher and should be joined in at
/// read time (e.g. for the future Tuition Ledger), same pattern as
/// everywhere else in this schema.
///
/// `parentId` is denormalized alongside `studentId`, same reasoning
/// as `DemoBooking.parentId` — lets Accounts-side queries filter
/// directly on parentId without an extra join through Student.
///
/// Pricing formula used by enrollment.service.ts (flagged back as an
/// assumption in 06-OPEN-DECISIONS.md — nothing in the docs actually
/// states how Course.price maps to a per-session vs. monthly rate,
/// so this is a judgment call pending sign-off, not a settled rule):
///   ratePerSession = Course.price (teacher's per-session rate)
///   monthlyRate    = ratePerSession * sessionsPerMonth
///   totalAmount    = monthlyRate * noOfMonths
///   dueDate        = cycleStartDate + 1 month
///
/// Sequential dual-approval (resolves 06-OPEN-DECISIONS.md #2, per
/// direct clarification Sep 1, 2026): Teacher reviews first, then
/// Admin has final say. Every new Enrollment starts at
/// PENDING_TEACHER_APPROVAL (payment already happened by this point).
/// See `status`'s own doc-comment below and
/// src/features/shared/server/enrollmentApproval.service.ts for the
/// full state machine.
model Enrollment {
  id String @id @default(uuid())

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  parentId String
  // Added alongside the dual-approval workflow — Teacher/Admin
  // approval queues need the parent's name/email/phone, and a plain
  // denormalized ID with no relation couldn't be `include`d. Every
  // existing row already has a valid parentId, so this is additive
  // and safe against live data.
  parent   ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  subject String?

  // Cycle rule (updated Aug 31, 2026, supersedes 06-OPEN-DECISIONS.md
  // #25's old fixed 4/8/12/24/30 set): min 4, max 31 (1/day for the
  // longest month) — enforced in enrollment.service.ts, not just
  // trusted from the client.
  sessionsPerMonth Int
  noOfMonths       Int @default(1)

  // System-calculated, never manually entered (03-DATA-MODEL.md).
  ratePerSession Decimal @db.Decimal(10, 2)
  monthlyRate    Decimal @db.Decimal(10, 2)
  totalAmount    Decimal @db.Decimal(10, 2)

  cycleStartDate DateTime
  dueDate        DateTime

  // Weekly recurring class schedule (added for the Parent/Teacher
  // calendar view). Parent proposes this at Enrollment creation
  // (BookingPanel.tsx) alongside the cycle; Teacher can revise it
  // the same way they already revise cycleStartDate/sessionsPerMonth
  // (teacherReviseEnrollment) — no separate approval step, since
  // it's covered by the same PENDING_PARENT_RECONFIRMATION flow.
  // scheduleDays: JS Date.getDay() convention, 0=Sunday..6=Saturday.
  // scheduleTime: 24-hour "HH:mm", wall-clock (no per-user timezone
  // yet — see 08-PROJECT-KNOWLEDGE-BASE.md, likely IST).
  // Both nullable/defaulted rather than required so this migration
  // is additive-safe against any Enrollment rows that already exist
  // (same reasoning as the parentId denormalization above) — the
  // calendar simply shows nothing for a row with no schedule set.
  scheduleDays Int[]   @default([])
  scheduleTime String?

  // Payment gate (06-OPEN-DECISIONS.md #36, resolved: Enrollment
  // creation now blocks on payment rather than allowing an unpaid
  // row). An Enrollment row is only ever written by
  // verifyEnrollmentPayment() AFTER Razorpay confirms the charge —
  // so these are required, not optional, and every Enrollment that
  // exists is by definition paid. `amountPaid` is captured
  // separately from `totalAmount` (even though they should always
  // match) so a future partial-payment/refund scenario has
  // somewhere to diverge without a schema change.
  razorpayOrderId   String   @unique
  razorpayPaymentId String   @unique
  amountPaid        Decimal  @db.Decimal(10, 2)
  paidAt            DateTime @default(now())

  // DECIDED (#27): 45 days with no class taken -> auto-lapse.
  // Reactivation/pre-warning still open (#34, non-blocking for MVP).
  // Null until the first ClassSession is built and marked complete.
  lastClassAt DateTime?

  // Sequential dual-approval (resolves #2, per direct clarification
  // Sep 1, 2026): Teacher reviews first — approve as-is, revise the
  // cycle, or reject. Once the Teacher side is settled (either
  // approved outright, or a revision the Parent has reconfirmed),
  // it moves to Admin. Admin has final say: reject here is terminal
  // (REJECTED), it does not bounce back to Teacher. Parent-facing
  // copy NEVER mentions Admin by name (see status-label helper) —
  // "pending" reads as "waiting for teacher approval" the whole way
  // through, per direct instruction.
  status EnrollmentStatus @default(PENDING_TEACHER_APPROVAL)

  teacherApprovedAt DateTime?
  adminApprovedAt   DateTime?

  rejectedBy       String? // "TEACHER" | "ADMIN"
  rejectionReason  String?

  // Teacher-proposed schedule/cycle revision. `revisedByTeacher`
  // flips true the first time a Teacher revises; `revisionNote` is
  // the Teacher's own explanation, shown to the Parent alongside
  // the Confirm/Decline choice. Discussion itself happens in the
  // enrollment's ChatRoom (the sole Parent<->Teacher channel) —
  // this note is just a short heads-up, not the full conversation.
  revisedByTeacher Boolean @default(false)
  revisionNote     String?

  // Set true if a Teacher's revision changed sessionsPerMonth (and
  // therefore monthlyRate/totalAmount) away from what was actually
  // charged via Razorpay (`amountPaid`, still untouched/historical).
  // No automatic extra charge or refund happens — flagged for Admin
  // to see and reconcile manually before final approval. Revising
  // only cycleStartDate never sets this (no cost impact).
  pricingChangedAfterPayment Boolean @default(false)

  // Cycle progress (added Sep 3, 2026). A "cycle" = one calendar
  // month's worth of sessions, i.e. `sessionsPerMonth`. Marking a
  // session complete is manual for now (Teacher-only,
  // POST .../mark-session) — a placeholder for automatic tracking
  // once class scheduling / Zoho integration exists (per direct
  // instruction: "later we will set increment and logic after
  // connection with zoho api"). `cyclePayoutStatus` flips to
  // READY_FOR_PAYOUT the moment a cycle's sessions are all marked
  // done, but nothing actually pays the teacher out yet — the
  // Wallet/Tuition Ledger this would need isn't built
  // (03-DATA-MODEL.md). Treat this as tracking + a future payout
  // gate, not a working payout flow.
  sessionsCompletedInCycle Int               @default(0)
  cyclesCompleted          Int               @default(0)
  cyclePayoutStatus        CyclePayoutStatus @default(IN_PROGRESS)
  lastSessionMarkedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // One chat room per enrollment (a specific parent+teacher+course+
  // child combination) — see ChatRoom's doc-comment below for why
  // this is gated on Enrollment existing rather than on
  // EnrollmentStatus == APPROVED (dual-approval workflow, #2, isn't
  // built yet, so nothing can reach APPROVED today).
  chatRoom ChatRoom?

  @@index([parentId])
  @@index([teacherId])
  @@index([courseId])
  @@index([studentId])
}

enum EnrollmentStatus {
  // Legacy — no longer written by new code (kept so any existing
  // rows in this status still deserialize/display fine; see
  // 07-LESSONS-LEARNED.md re: never drop enum values that live data
  // may already be using).
  PENDING_APPROVAL
  APPROVED

  // Sequential dual-approval flow (resolves #2):
  PENDING_TEACHER_APPROVAL     // paid, waiting on Teacher
  PENDING_PARENT_RECONFIRMATION // Teacher revised the cycle/date, waiting on Parent
  PENDING_ADMIN_APPROVAL       // Teacher side settled, waiting on Admin

  REJECTED   // terminal — set by either Teacher or Admin (see rejectedBy)
  ACTIVE     // both approvals done — lectures can be scheduled
  LAPSED
  CANCELLED
}

/// Cycle payout status (added Sep 3, 2026) — informational/future
/// gate only. Nothing reads this to actually withhold or release
/// money yet, since Wallet/Tuition Ledger don't exist
/// (03-DATA-MODEL.md). RELEASED isn't set anywhere in code today;
/// it's reserved for whatever Accounts-side flow eventually
/// consumes READY_FOR_PAYOUT enrollments.
enum CyclePayoutStatus {
  IN_PROGRESS      // current cycle still has sessions left
  READY_FOR_PAYOUT // current cycle's sessions are all marked done
  RELEASED         // reserved for future Accounts/payout flow
}

/// One chat room per Enrollment — i.e. one per (parent, teacher,
/// course, child) combination. From the Teacher's side this reads as
/// "a separate chat room per child"; from the Parent's side, "a
/// separate chat room per teacher+course" — both are the same
/// underlying 1:1-with-Enrollment shape, per the request that
/// prompted this feature.
///
/// **Gating decision:** a ChatRoom is deliberately created alongside
/// *every* new Enrollment, not gated on `APPROVED`/`ACTIVE` — the
/// chat room IS the channel Teacher/Parent use to work out the
/// dual-approval flow itself (revisions, discussion), so it has to
/// exist from PENDING_TEACHER_APPROVAL onward, not after approval
/// finishes. See enrollmentApproval.service.ts for the full flow.
/// `REJECTED`/`CANCELLED` enrollments keep their room for Admin's
/// record, but Parent/Teacher sending is blocked — see
/// chat.service.ts's `SENDABLE_ENROLLMENT_STATUSES`.
model ChatRoom {
  id String @id @default(uuid())

  enrollmentId String     @unique
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  // Denormalized alongside enrollmentId, same reasoning as
  // DemoBooking.parentId / Enrollment.parentId elsewhere in this
  // schema — lets each role's room-list query filter directly
  // without an extra join through Enrollment.
  parentId  String
  parent    ParentProfile @relation(fields: [parentId], references: [id], onDelete: Cascade)

  teacherId String
  teacher   Teacher @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  courseId String
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)

  studentId String
  student   Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  lastMessageAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([parentId])
  @@index([teacherId])
  @@index([courseId])
  @@index([studentId])
  @@index([lastMessageAt])
}

/// `senderId` stores the ParentProfile.id or Teacher.id of whoever
/// sent the message — not the raw Cognito `sub` — so Admin's
/// moderation view can join straight to a display name without
/// re-decoding a token. `senderRole` disambiguates which table
/// `senderId` points into (there's no single generic `User` table
/// yet — see 03-DATA-MODEL.md).
model ChatMessage {
  id String @id @default(uuid())

  chatRoomId String
  chatRoom   ChatRoom @relation(fields: [chatRoomId], references: [id], onDelete: Cascade)

  senderRole ChatSenderRole
  senderId   String

  body String @db.Text

  createdAt DateTime @default(now())

  @@index([chatRoomId, createdAt])
}

enum ChatSenderRole {
  PARENT
  TEACHER
}

/// Admin-created internal staff accounts (HR, Accounts). Cognito remains
/// the identity source (custom:role = "hr" | "accounts") — this row is
/// only a lightweight directory entry so Admin's Manage Staff Accounts
/// screen has something to list/search/delete against, following the
/// same pattern as ParentProfile/Teacher. Deliberately minimal for now —
/// no onboarding/profile/dashboard fields yet, those come later per
/// 06-OPEN-DECISIONS.md #16 (Accounts role scope still unconfirmed) and
/// HR isn't in the original 4-role MVP model (02-ARCHITECTURE.md) at all,
/// so this is explicitly scoped as "create the identity, nothing else."
model StaffAccount {
  id          String     @id @default(uuid())
  cognitoSub  String     @unique
  role        StaffRole
  firstName   String
  lastName    String
  email       String     @unique
  phone       String
  createdById String // Admin.id of whoever created this account
  createdAt   DateTime   @default(now())

  @@index([role])
}

enum StaffRole {
  HR
  ACCOUNTS
}
